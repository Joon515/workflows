{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book terminology",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authority_locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "protected_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          }
        },
        "required": [
          "id",
          "number",
          "source",
          "target",
          "authority",
          "authority_locator",
          "rationale",
          "protected_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "terms"
  ],
  "additionalProperties": false
}
